<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctl="clr-namespace:EditFlow.App.Controls"
        xmlns:views="clr-namespace:EditFlow.App.Views"
        mc:Ignorable="d" d:DesignWidth="1340" d:DesignHeight="800"
        x:Class="EditFlow.App.MainWindow"
        Title="EditFlow"
        Icon="avares://EditFlow/Assets/app.ico"
        Width="1400" Height="840"
        MinWidth="1080" MinHeight="700"
        Background="{DynamicResource Bg}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <views:HomeView x:Name="Home" />

        <!--
            Editor. Tres zonas, como en los editores de referencia: a la izquierda los medios,
            en el centro el preview con la timeline debajo, y a la derecha las propiedades de
            lo seleccionado. Cada zona tiene su columna de pestañas con icono.
        -->
        <Grid x:Name="EditorRoot" IsVisible="False" RowDefinitions="54,*,28">

            <!-- Barra superior -->
            <Border Grid.Row="0" Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Button x:Name="HomeButton" Classes="quiet" Padding="12,7"
                                ToolTip.Tip="Volver a la pantalla de inicio">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Data="{StaticResource IconHome}" Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="15" Height="15" />
                                <TextBlock Text="Inicio" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="ProjectNameLabel" Text="EditFlow" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button x:Name="SaveProjectButton" Content="Guardar" Classes="quiet"
                                ToolTip.Tip="Guardar el proyecto  (Ctrl + S)" />
                        <Button x:Name="SaveAndHomeButton" Content="Guardar y salir" Classes="quiet"
                                ToolTip.Tip="Guardar el proyecto y volver al menú principal  (Ctrl + Mayús + W)" />
                        <Button x:Name="ExportButton" Content="Exportar" Classes="primary" Padding="20,8"
                                ToolTip.Tip="Exportar el video  (Ctrl + E)" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Cuerpo -->
            <Grid Grid.Row="1" ColumnDefinitions="76,304,*,Auto,76">

                <!-- Columna de pestañas izquierda -->
                <Border Grid.Column="0" Background="{DynamicResource Sidebar}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="6,10">
                    <StackPanel Spacing="4">
                        <Button x:Name="RailMedia" Classes="rail selected" ToolTip.Tip="Los archivos del proyecto">
                            <StackPanel Spacing="5">
                                <Path Data="{StaticResource IconFolder}" Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="20" Height="20" />
                                <TextBlock Text="Multimedia" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RailText" Classes="rail" ToolTip.Tip="Títulos, subtítulos e imágenes sobre el video">
                            <StackPanel Spacing="5">
                                <Path Data="{StaticResource IconText}" Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="20" Height="20" />
                                <TextBlock Text="Texto" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RailTransitions" Classes="rail soon" ToolTip.Tip="Transiciones: próximamente">
                            <StackPanel Spacing="5">
                                <Path Data="{StaticResource IconTransition}" Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="20" Height="20" />
                                <TextBlock Text="Transiciones" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Panel izquierdo: medios -->
                <Border Grid.Column="1" Background="{DynamicResource Sidebar}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid x:Name="MediaPanel" RowDefinitions="Auto,Auto,*,Auto" Margin="16,16,16,12">
                            <TextBlock Grid.Row="0" Text="Multimedia" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" />

                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,14,0,14">
                                <Button x:Name="ImportButton" Classes="primary" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center" Padding="0,10"
                                        ToolTip.Tip="Añadir videos al proyecto y a la timeline">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Data="{StaticResource IconImport}" Fill="White"
                                              Stretch="Uniform" Width="16" Height="16" />
                                        <TextBlock Text="Importar video" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ImportAudioButton" Grid.Column="1" Classes="quiet" Margin="8,0,0,0"
                                        Padding="12,10" ToolTip.Tip="Añadir música o voz en la posición del cabezal">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Path Data="{StaticResource IconMusic}" Fill="{Binding $parent[Button].Foreground}"
                                              Stretch="Uniform" Width="15" Height="15" />
                                        <TextBlock Text="Audio" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <WrapPanel x:Name="MediaGrid" />
                                    <TextBlock x:Name="MediaEmptyText" Foreground="{DynamicResource TextMuted}"
                                               FontSize="12" TextWrapping="Wrap" Margin="2,8,2,0"
                                               Text="Aún no hay archivos. Importa un video para empezar." />
                                </Grid>
                            </ScrollViewer>

                            <Border Grid.Row="3" Margin="0,10,0,0" Padding="0,10,0,0"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="heading" Text="INFORMACIÓN" />
                                    <TextBlock x:Name="MediaPoolInfo" Text="—" FontSize="11"
                                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" LineHeight="17" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel x:Name="TextPanel" IsVisible="False" Margin="16,16,16,12" Spacing="10">
                            <TextBlock Text="Texto y capas" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" />
                            <TextBlock FontSize="12" TextWrapping="Wrap" LineHeight="18"
                                       Foreground="{DynamicResource TextMuted}"
                                       Text="Se añaden en el cabezal y duran 5 s. Después puedes editar su texto, moverlos, cambiar el tamaño y ajustar cuánto tiempo se ven." />

                            <Button x:Name="AddTitleButton" Classes="card" Height="76" Margin="0,6,0,0" HorizontalAlignment="Stretch"
                                    ToolTip.Tip="Un título grande y centrado">
                                <TextBlock Text="Título" FontSize="26" FontWeight="Bold"
                                           Foreground="{DynamicResource Text}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="AddSubtitleButton" Classes="card" Height="56" HorizontalAlignment="Stretch"
                                    ToolTip.Tip="Una línea pequeña al pie de la imagen">
                                <TextBlock Text="Subtítulo" FontSize="16"
                                           Foreground="{DynamicResource Text}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="AddPlainTextButton" Classes="card" Height="48" HorizontalAlignment="Stretch"
                                    ToolTip.Tip="Un texto sencillo en el centro">
                                <TextBlock Text="Texto" FontSize="14"
                                           Foreground="{DynamicResource TextMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>

                            <Border Margin="0,10,0,0" Padding="0,14,0,0"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="heading" Text="IMAGEN" />
                                    <Button x:Name="AddImageButton" Classes="quiet" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            ToolTip.Tip="Un logotipo o una imagen sobre el video">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Data="{StaticResource IconImport}" Fill="{Binding $parent[Button].Foreground}"
                                                  Stretch="Uniform" Width="15" Height="15" />
                                            <TextBlock Text="Superponer imagen…" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,10,0,0" Padding="0,14,0,0"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="heading" Text="SUBTÍTULOS AUTOMÁTICOS" />
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap" LineHeight="17"
                                               Foreground="{DynamicResource TextMuted}"
                                               Text="Transcribe el sonido del montaje en tu equipo con Whisper: nada se envía a internet. Los subtítulos quedan como textos que puedes corregir." />
                                    <Grid ColumnDefinitions="78,*">
                                        <TextBlock Grid.Column="0" Text="Audio en" FontSize="12"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" x:Name="SubtitleLanguageBox" HorizontalAlignment="Stretch"
                                                  ToolTip.Tip="El idioma que se habla en el video. «Automático» lo detecta." />
                                    </Grid>
                                    <Grid ColumnDefinitions="78,*">
                                        <TextBlock Grid.Column="0" Text="Subtítulos en" FontSize="12"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" x:Name="SubtitleTargetBox" HorizontalAlignment="Stretch"
                                                  ToolTip.Tip="El idioma de los subtítulos. Si es distinto del audio, se traducen en tu equipo." />
                                    </Grid>
                                    <Grid ColumnDefinitions="78,*">
                                        <TextBlock Grid.Column="0" Text="Modelo" FontSize="12"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" x:Name="SubtitleModelBox" HorizontalAlignment="Stretch" />
                                    </Grid>
                                    <TextBlock x:Name="SubtitleSetupNote" FontSize="11" TextWrapping="Wrap" LineHeight="16"
                                               Foreground="{DynamicResource TextFaint}" />
                                    <Button x:Name="GenerateSubtitlesButton" Classes="primary" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" Content="Generar subtítulos" />
                                    <ProgressBar x:Name="SubtitleProgress" Minimum="0" Maximum="100" Height="4" IsVisible="False" />
                                    <Border x:Name="SubtitleResultBox" IsVisible="False" CornerRadius="6" Padding="10,8"
                                            BorderThickness="1">
                                        <TextBlock x:Name="SubtitleResultText" FontSize="11.5" TextWrapping="Wrap" LineHeight="17"
                                                   Foreground="{DynamicResource Text}" />
                                    </Border>
                                    <Button x:Name="CancelSubtitlesButton" Classes="quiet" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" Content="Cancelar" IsVisible="False" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="TransitionsPanel" IsVisible="False" Margin="16,16,16,12" Spacing="10">
                            <TextBlock Text="Transiciones" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" />
                            <TextBlock FontSize="12" TextWrapping="Wrap" LineHeight="17"
                                       Foreground="{DynamicResource TextMuted}"
                                       Text="Selecciona un clip de la pista principal (que no sea el primero) y haz clic en una: se aplica desde el clip anterior hacia el seleccionado. También puedes abrir «Transición» en el panel de la derecha para ajustar la duración." />
                            <WrapPanel x:Name="TransitionGallery" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Centro: preview y timeline -->
                <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,Auto" Margin="0">

                    <!-- Herramientas sobre el preview -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="16,10,16,0">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="UndoButton" Classes="tool" ToolTip.Tip="Deshacer  (Ctrl + Z)">
                                <Path Data="{StaticResource IconUndo}" Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="17" Height="17" />
                            </Button>
                            <Button x:Name="RedoButton" Classes="tool" ToolTip.Tip="Rehacer  (Ctrl + Y)">
                                <Path Data="{StaticResource IconUndo}" Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="17" Height="17"
                                      RenderTransformOrigin="50%,50%">
                                    <Path.RenderTransform>
                                        <ScaleTransform ScaleX="-1" />
                                    </Path.RenderTransform>
                                </Path>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Column="2" x:Name="EncoderLabel" Text="—" FontSize="11"
                                   Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                    </Grid>

                    <!--
                        Superficie propia: los fotogramas los decodifica EditFlow y se dibujan en un
                        control normal de Avalonia. Sustituye al VideoView de LibVLCSharp, que era
                        una ventana nativa y tapaba cualquier control superpuesto (ver docs/PLAN.md
                        §13). Ahora superponer texto, color o tiradores deja de ser un problema.
                    -->
                    <Border Grid.Row="1" Margin="16,10" Background="Black" CornerRadius="8" ClipToBounds="True">
                        <ctl:VideoSurface x:Name="Video" />
                    </Border>

                    <!-- Transporte, centrado bajo el preview -->
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="16,0,16,8">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                            <Button x:Name="SplitButton" Classes="tool" ToolTip.Tip="Dividir en el cabezal  (S)">
                                <Path Data="{StaticResource IconScissors}" Stroke="{Binding $parent[Button].Foreground}"
                                      StrokeThickness="1.8" Stretch="Uniform" Width="17" Height="17" />
                            </Button>
                            <Button x:Name="DeleteButton" Classes="tool" ToolTip.Tip="Eliminar lo seleccionado  (Supr)">
                                <Path Data="{StaticResource IconTrash}" Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="17" Height="17" />
                            </Button>
                            <Button x:Name="LiftButton" Classes="tool"
                                    ToolTip.Tip="Subir el clip seleccionado a una capa superior  (U)">
                                <Path Data="M12,3 L5,11 H10 V20 H14 V11 H19 Z" Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="16" Height="16" />
                            </Button>
                            <Border Width="1" Background="{DynamicResource Line}" Margin="8,7" />
                            <Button x:Name="CacheButton" Classes="tool" Width="NaN" MinWidth="70" Padding="12,0" FontSize="12" Content="Render">
                                <Button.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuItem x:Name="CacheClearItem" Header="Limpiar copias de preview" />
                                    </MenuFlyout>
                                </Button.ContextFlyout>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
<StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                <TextBlock x:Name="PositionLabel"
                                           FontFamily="Consolas,Menlo,monospace" FontSize="14"
                                           Foreground="{DynamicResource Text}" VerticalAlignment="Center">
                                    <Run x:Name="PositionNow" FontWeight="Bold" Text="0:00.00" /><Run x:Name="PositionTotal"
                                         Foreground="{DynamicResource TextFaint}" Text=" / 0:00.00" />
                                </TextBlock>
                                <TextBlock x:Name="PlaybackInfo" FontSize="11" Foreground="{DynamicResource TextFaint}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <Button x:Name="Back30Button" Classes="tool" Width="46" FontSize="12"
                                    ToolTip.Tip="Retroceder 30 segundos  (Mayús + ←)" Content="−30 s" />
                            <Button x:Name="Back5Button" Classes="tool" Width="42" FontSize="12"
                                    ToolTip.Tip="Retroceder 5 segundos  (←)" Content="−5 s" />
                            <Button x:Name="PlayPauseButton" Classes="play"
                                    ToolTip.Tip="Reproducir o pausar  (Espacio)">
                                <Path x:Name="PlayIcon" Data="{StaticResource IconPlay}" Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="16" Height="16" Margin="2,0,0,0" />
                            </Button>
                            <Button x:Name="Forward5Button" Classes="tool" Width="42" FontSize="12"
                                    ToolTip.Tip="Avanzar 5 segundos  (→)" Content="+5 s" />
                            <Button x:Name="Forward30Button" Classes="tool" Width="46" FontSize="12"
                                    ToolTip.Tip="Avanzar 30 segundos  (Mayús + →)" Content="+30 s" />
                        </StackPanel>
</StackPanel>

                        <!-- Calidad del preview: solo afecta a lo que se ve aquí, nunca a la exportación -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBox x:Name="PlaybackBox" Width="104" FontSize="12" MinHeight="30" Padding="10,3"
                                      ToolTip.Tip="Resolución de reproducción del preview (solo afecta a lo que ves aquí; la exportación siempre sale a la resolución que elijas). Más baja = más fluido en equipos justos." />
                        </StackPanel>

                    </Grid>

                    <!-- Timeline -->
                    <Border Grid.Row="3" Background="#161619" Margin="0"
                            BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                        <Grid>
                            <!-- Crece con el número de pistas hasta un máximo, y a partir de ahí se
                                 desplaza. Con altura fija, la tercera pista de audio quedaba fuera. -->
                            <ScrollViewer x:Name="TimelineScroll" HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          MinHeight="170" MaxHeight="340">
                                <Grid>
                                    <ctl:TimelineControl x:Name="Timeline" />
                                    <ctl:PlayheadLayer x:Name="PlayheadOverlay" IsHitTestVisible="False" />
                                </Grid>
                            </ScrollViewer>

                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom" Margin="0,0,18,16">
                                <Button x:Name="ZoomOutButton" Classes="tool" ToolTip.Tip="Alejar  (Ctrl + rueda)">
                                    <Path Data="{StaticResource IconMinus}" Fill="{Binding $parent[Button].Foreground}"
                                          Stretch="Uniform" Width="15" Height="15" />
                                </Button>
                                <Button x:Name="ZoomInButton" Classes="tool" ToolTip.Tip="Acercar  (Ctrl + rueda)">
                                    <Path Data="{StaticResource IconPlus}" Fill="{Binding $parent[Button].Foreground}"
                                          Stretch="Uniform" Width="15" Height="15" />
                                </Button>
                                <Button x:Name="ZoomFitButton" Classes="tool" ToolTip.Tip="Ajustar todo el montaje a la pantalla">
                                    <Path Data="{StaticResource IconFit}" Fill="{Binding $parent[Button].Foreground}"
                                          Stretch="Uniform" Width="16" Height="16" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Panel derecho: propiedades -->
                <Border x:Name="InspectorPanel" Grid.Column="3" Width="300" IsVisible="False"
                        Background="{DynamicResource Sidebar}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18,16,18,18" Spacing="4">
                            <TextBlock x:Name="InspectorTitle" Text="Audio" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" />
                            <TextBlock x:Name="InspectorTarget" FontSize="11.5"
                                       Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"
                                       Margin="0,0,0,10" />

                            <TextBlock x:Name="InspectorNothing" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMuted}" LineHeight="18" />

                            <StackPanel x:Name="LayerControls" Spacing="6" IsVisible="False">

                                <StackPanel x:Name="TextControls" Spacing="6">
                                    <TextBlock Text="Texto" Foreground="{DynamicResource Text}" FontSize="13" />
                                    <TextBox x:Name="TextContentBox" AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="70" MaxHeight="140" />

                                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                        <TextBlock Text="Tamaño" Foreground="{DynamicResource Text}" FontSize="13" />
                                        <TextBlock x:Name="TextSizeReadout" Grid.Column="1" Text="8 %"
                                                   FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </Grid>
                                    <Slider x:Name="TextSizeSlider" Minimum="2" Maximum="40" Value="8"
                                            TickFrequency="1" IsSnapToTickEnabled="True" />

                                    <TextBlock Text="Fuente" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,8,0,0" />
                                    <ComboBox x:Name="FontFamilyCombo" HorizontalAlignment="Stretch" />
                                    <Button x:Name="ImportFontButton" Content="Importar tipografía…" Classes="quiet"
                                            FontSize="11" Padding="10,5" Margin="0,4,0,0" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="ImportedFontLabel" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" IsVisible="False" />

                                    <TextBlock Text="Color" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,8,0,0" />
                                    <WrapPanel x:Name="ColorSwatches" />
                                    <TextBox x:Name="ColorHexBox" MaxLength="7" Watermark="#RRGGBB" Width="120"
                                             HorizontalAlignment="Left" />

                                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
                                        <CheckBox x:Name="BoldCheck" Content="Negrita" />
                                        <CheckBox x:Name="ItalicCheck" Content="Cursiva" />
                                        <CheckBox x:Name="ShadowCheck" Content="Sombra" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel x:Name="ImageControls" Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Ancho" Foreground="{DynamicResource Text}" FontSize="13" />
                                        <TextBlock x:Name="ImageWidthReadout" Grid.Column="1" Text="25 %"
                                                   FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </Grid>
                                    <Slider x:Name="ImageWidthSlider" Minimum="2" Maximum="100" Value="25"
                                            TickFrequency="1" IsSnapToTickEnabled="True" />
                                </StackPanel>

                                <Border Margin="0,10,0,0" Padding="0,12,0,0"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Posición horizontal" Foreground="{DynamicResource Text}" FontSize="13" />
                                            <TextBlock x:Name="PosXReadout" Grid.Column="1" Text="50 %"
                                                       FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </Grid>
                                        <Slider x:Name="PosXSlider" Minimum="0" Maximum="100" Value="50"
                                                TickFrequency="1" IsSnapToTickEnabled="True" />

                                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                            <TextBlock Text="Posición vertical" Foreground="{DynamicResource Text}" FontSize="13" />
                                            <TextBlock x:Name="PosYReadout" Grid.Column="1" Text="85 %"
                                                       FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </Grid>
                                        <Slider x:Name="PosYSlider" Minimum="0" Maximum="100" Value="85"
                                                TickFrequency="1" IsSnapToTickEnabled="True" />

                                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                            <TextBlock Text="Opacidad" Foreground="{DynamicResource Text}" FontSize="13" />
                                            <TextBlock x:Name="OpacityReadout" Grid.Column="1" Text="100 %"
                                                       FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </Grid>
                                        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="100"
                                                TickFrequency="1" IsSnapToTickEnabled="True" />

                                        <TextBlock Text="Animación" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,12,0,0" />
                                        <TextBlock Text="Pon un punto, mueve el cabezal y cambia el valor: el elemento se mueve, crece o aparece solo."
                                                   FontSize="11" TextWrapping="Wrap" LineHeight="16"
                                                   Foreground="{DynamicResource TextFaint}" />

                                        <TextBlock Text="Posición" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,0" />
                                        <ctl:KeyframeStrip x:Name="LayerPositionKeys" />
                                        <TextBlock Text="Ancho" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0" />
                                        <ctl:KeyframeStrip x:Name="LayerWidthKeys" />
                                        <TextBlock Text="Opacidad" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0" />
                                        <ctl:KeyframeStrip x:Name="LayerOpacityKeys" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,10,0,0" Padding="0,12,0,0"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Aparece en" Foreground="{DynamicResource Text}" FontSize="13"
                                                       ToolTip.Tip="En vez de aparecer de golpe, sube la opacidad durante estos segundos" />
                                            <TextBlock x:Name="OverlayFadeInReadout" Grid.Column="1" Text="0 s"
                                                       FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </Grid>
                                        <Slider x:Name="OverlayFadeInSlider" Minimum="0" Maximum="5" Value="0"
                                                TickFrequency="0.1" IsSnapToTickEnabled="True" />

                                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                            <TextBlock Text="Desaparece en" Foreground="{DynamicResource Text}" FontSize="13"
                                                       ToolTip.Tip="Baja la opacidad hasta desaparecer durante estos segundos, en vez de cortar de golpe" />
                                            <TextBlock x:Name="OverlayFadeOutReadout" Grid.Column="1" Text="0 s"
                                                       FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </Grid>
                                        <Slider x:Name="OverlayFadeOutSlider" Minimum="0" Maximum="5" Value="0"
                                                TickFrequency="0.1" IsSnapToTickEnabled="True" />
                                    </StackPanel>
                                </Border>

                                <Border x:Name="ChromaControls" Margin="0,10,0,0" Padding="0,12,0,0"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" IsVisible="False">
                                    <StackPanel Spacing="6">
                                        <CheckBox x:Name="ChromaEnabledCheck" Content="Recortar el fondo"
                                                  ToolTip.Tip="Pantalla verde: vuelve transparente el fondo para que se vea la capa de abajo" />
                                        <TextBlock FontSize="11" TextWrapping="Wrap" LineHeight="16"
                                                   Foreground="{DynamicResource TextFaint}"
                                                   Text="Lo que se recorta deja ver lo que haya debajo en la timeline. Con esta capa arriba del todo, debajo está el video principal." />

                                        <StackPanel x:Name="ChromaDetails" Spacing="6" Margin="0,6,0,0" IsVisible="False">
                                            <TextBlock Text="Color del fondo" Foreground="{DynamicResource Text}" FontSize="13" />
                                            <WrapPanel x:Name="ChromaSwatches" />
                                            <TextBox x:Name="ChromaHexBox" MaxLength="7" Watermark="#RRGGBB" Width="120"
                                                     HorizontalAlignment="Left" />

                                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                                <TextBlock Text="Tolerancia" Foreground="{DynamicResource Text}" FontSize="13"
                                                           ToolTip.Tip="Cuánto se puede apartar un color del elegido y aun así borrarse. Si queda fondo, súbela; si desaparece el sujeto, bájala" />
                                                <TextBlock x:Name="ChromaSimilarityReadout" Grid.Column="1" Text="20 %"
                                                           FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                                           Foreground="{DynamicResource TextMuted}" />
                                            </Grid>
                                            <Slider x:Name="ChromaSimilaritySlider" Minimum="1" Maximum="100" Value="20"
                                                    TickFrequency="1" IsSnapToTickEnabled="True" />

                                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                                <TextBlock Text="Suavizado del borde" Foreground="{DynamicResource Text}" FontSize="13"
                                                           ToolTip.Tip="En 0 el contorno queda dentado; subirlo deja un borde semitransparente que se integra mejor" />
                                                <TextBlock x:Name="ChromaBlendReadout" Grid.Column="1" Text="5 %"
                                                           FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                                           Foreground="{DynamicResource TextMuted}" />
                                            </Grid>
                                            <Slider x:Name="ChromaBlendSlider" Minimum="0" Maximum="100" Value="5"
                                                    TickFrequency="1" IsSnapToTickEnabled="True" />

                                            <CheckBox x:Name="ChromaDespillCheck" Content="Quitar el tinte del fondo"
                                                      Margin="0,6,0,0"
                                                      ToolTip.Tip="Borra el halo verdoso que el fondo derrama sobre el pelo y los hombros" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="VideoControls" Margin="0,10,0,0" Padding="0,12,0,0"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                                    <StackPanel Spacing="6">
                                        <TextBlock x:Name="VideoAudioHint" FontSize="11" TextWrapping="Wrap" LineHeight="16"
                                                   Foreground="{DynamicResource TextFaint}"
                                                   Text="Su volumen y silencio se ajustan en la pestaña Audio, como el de cualquier otro clip." />
                                        <Button x:Name="LowerButton" Content="Bajar a la pista principal" Classes="quiet"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Margin="0,6,0,0" />
                                        <TextBlock x:Name="LowerHint" FontSize="11" TextWrapping="Wrap" LineHeight="16"
                                                   Foreground="{DynamicResource TextFaint}" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,10,0,0" Padding="0,12,0,0"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                                    <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto">
                                        <TextBlock Text="Empieza (s)" Foreground="{DynamicResource Text}" FontSize="13" />
                                        <TextBlock Grid.Column="2" Text="Dura (s)" Foreground="{DynamicResource Text}" FontSize="13" />
                                        <NumericUpDown x:Name="StartBox" Grid.Row="1" Minimum="0" Maximum="86400"
                                                       Increment="0.1" FormatString="0.0" Value="0" Margin="0,6,0,0" />
                                        <NumericUpDown x:Name="DurationBox" Grid.Row="1" Grid.Column="2" Minimum="0.2" Maximum="86400"
                                                       Increment="0.1" FormatString="0.0" Value="5" Margin="0,6,0,0" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="ColorControls" Spacing="6" IsVisible="False">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,0">
                                <TextBlock Text="Exposición" Foreground="{DynamicResource Text}" FontSize="13"
                                           ToolTip.Tip="Aclara u oscurece toda la imagen, como abrir o cerrar el diafragma" />
                                <TextBlock x:Name="ExposureReadout" Grid.Column="1" Text="0"
                                           FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                           Foreground="{DynamicResource TextMuted}" />
                            </Grid>
                            <Slider x:Name="ExposureSlider" Minimum="-100" Maximum="100" Value="0"
                                    TickFrequency="1" IsSnapToTickEnabled="True" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                <TextBlock Text="Contraste" Foreground="{DynamicResource Text}" FontSize="13"
                                           ToolTip.Tip="Separa más o menos las luces de las sombras" />
                                <TextBlock x:Name="ContrastReadout" Grid.Column="1" Text="0"
                                           FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                           Foreground="{DynamicResource TextMuted}" />
                            </Grid>
                            <Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" Value="0"
                                    TickFrequency="1" IsSnapToTickEnabled="True" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                <TextBlock Text="Saturación" Foreground="{DynamicResource Text}" FontSize="13"
                                           ToolTip.Tip="-100 deja la imagen en blanco y negro; 100 duplica la intensidad de los colores" />
                                <TextBlock x:Name="SaturationReadout" Grid.Column="1" Text="0"
                                           FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                           Foreground="{DynamicResource TextMuted}" />
                            </Grid>
                            <Slider x:Name="SaturationSlider" Minimum="-100" Maximum="100" Value="0"
                                    TickFrequency="1" IsSnapToTickEnabled="True" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                <TextBlock Text="Temperatura" Foreground="{DynamicResource Text}" FontSize="13"
                                           ToolTip.Tip="Negativo enfría la imagen (azulada); positivo la calienta (anaranjada)" />
                                <TextBlock x:Name="TemperatureReadout" Grid.Column="1" Text="0"
                                           FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                           Foreground="{DynamicResource TextMuted}" />
                            </Grid>
                            <Slider x:Name="TemperatureSlider" Minimum="-100" Maximum="100" Value="0"
                                    TickFrequency="1" IsSnapToTickEnabled="True" />
                            <Border Margin="0,14,0,0" Padding="0,12,0,0"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                                <StackPanel Spacing="6">
                                    <ToggleButton x:Name="AdvancedColorToggle" Classes="quiet"
                                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                  Content="Color avanzado" FontSize="13" />

                                    <StackPanel x:Name="AdvancedColorPanel" Spacing="6" IsVisible="False" Margin="0,6,0,0">

                                        <TextBlock Text="Histograma" Foreground="{DynamicResource Text}" FontSize="13" />
                                        <TextBlock Text="Cuantos pixeles hay de cada nivel. Pegado al borde izquierdo son negros aplastados; al derecho, luces quemadas."
                                                   FontSize="11" TextWrapping="Wrap" LineHeight="16"
                                                   Foreground="{DynamicResource TextFaint}" />
                                        <ctl:HistogramScope x:Name="Histogram" />

                                        <TextBlock Text="Ruedas de color" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,12,0,0" />
                                        <TextBlock Text="Arrastra hacia el tono que quieras anadir. La rueda del raton ajusta la fuerza sin cambiar el tono."
                                                   FontSize="11" TextWrapping="Wrap" LineHeight="16"
                                                   Foreground="{DynamicResource TextFaint}" />
                                        <UniformGrid Columns="3" Margin="0,4,0,0">
                                            <StackPanel Spacing="2">
                                                <ctl:ColorWheelPad x:Name="ShadowWheel" Width="80" Height="80" />
                                                <TextBlock Text="Sombras" FontSize="11" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextMuted}" />
                                            </StackPanel>
                                            <StackPanel Spacing="2">
                                                <ctl:ColorWheelPad x:Name="MidtoneWheel" Width="80" Height="80" />
                                                <TextBlock Text="Medios" FontSize="11" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextMuted}" />
                                            </StackPanel>
                                            <StackPanel Spacing="2">
                                                <ctl:ColorWheelPad x:Name="HighlightWheel" Width="80" Height="80" />
                                                <TextBlock Text="Luces" FontSize="11" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextMuted}" />
                                            </StackPanel>
                                        </UniformGrid>

                                        <TextBlock Text="Curvas" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,12,0,0" />
                                        <TextBlock Text="Clic para anadir un punto, arrastra para moverlo, boton derecho para quitarlo. La diagonal no cambia nada."
                                                   FontSize="11" TextWrapping="Wrap" LineHeight="16"
                                                   Foreground="{DynamicResource TextFaint}" />
                                        <ComboBox x:Name="CurveChannelCombo" HorizontalAlignment="Stretch" />
                                        <ctl:CurveEditor x:Name="Curve" />
                                        <Button x:Name="CurveResetButton" Content="Enderezar la curva" Classes="quiet"
                                                FontSize="11" Padding="10,4" HorizontalAlignment="Left" />

                                        <TextBlock Text="Color selectivo" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,12,0,0" />
                                        <TextBlock Text="Retoca solo una familia de color, sin tocar el resto de la imagen."
                                                   FontSize="11" TextWrapping="Wrap" LineHeight="16"
                                                   Foreground="{DynamicResource TextFaint}" />
                                        <ComboBox x:Name="SelectiveFamilyCombo" HorizontalAlignment="Stretch" />
                                        <StackPanel x:Name="SelectiveSliders" Spacing="4" IsVisible="False">
                                            <TextBlock Text="Cian - Rojo" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                            <Slider x:Name="SelectiveCyanRed" Minimum="-100" Maximum="100" Value="0"
                                                    TickFrequency="1" IsSnapToTickEnabled="True" />
                                            <TextBlock Text="Magenta - Verde" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                            <Slider x:Name="SelectiveMagentaGreen" Minimum="-100" Maximum="100" Value="0"
                                                    TickFrequency="1" IsSnapToTickEnabled="True" />
                                            <TextBlock Text="Amarillo - Azul" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                            <Slider x:Name="SelectiveYellowBlue" Minimum="-100" Maximum="100" Value="0"
                                                    TickFrequency="1" IsSnapToTickEnabled="True" />
                                            <TextBlock Text="Luminosidad" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                            <Slider x:Name="SelectiveLightness" Minimum="-100" Maximum="100" Value="0"
                                                    TickFrequency="1" IsSnapToTickEnabled="True" />
                                        </StackPanel>

                                        <TextBlock Text="LUT" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,12,0,0" />
                                        <TextBlock Text="Un archivo .cube con un aspecto ya preparado. Se aplica antes que todo lo demas."
                                                   FontSize="11" TextWrapping="Wrap" LineHeight="16"
                                                   Foreground="{DynamicResource TextFaint}" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button x:Name="ImportLutButton" Content="Importar LUT..." Classes="quiet"
                                                    FontSize="11" Padding="10,5" />
                                            <Button x:Name="ClearLutButton" Content="Quitar" Classes="quiet"
                                                    FontSize="11" Padding="10,5" IsEnabled="False" />
                                        </StackPanel>
                                        <TextBlock x:Name="LutLabel" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMuted}" IsVisible="False" />

                                        <Button x:Name="GradeResetButton" Content="Quitar toda la correccion avanzada" Classes="quiet"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Margin="0,14,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Button x:Name="ColorResetButton" Content="Restablecer" Classes="quiet"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Margin="0,14,0,0" />
                            <TextBlock Text="El ajuste se ve en el preview y se aplica igual al exportar. Es solo del clip seleccionado."
                                       FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextFaint}" />
                            </StackPanel>

                            <StackPanel x:Name="FrameControls" Spacing="6" IsVisible="False">
                                <TextBlock Text="Arrastra los tiradores sobre el preview: las esquinas acercan o alejan, el círculo de arriba gira."
                                           FontSize="11" TextWrapping="Wrap" LineHeight="16"
                                           Foreground="{DynamicResource TextFaint}" />

                                <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                    <TextBlock Text="Zoom" Foreground="{DynamicResource Text}" FontSize="13" />
                                    <TextBlock x:Name="FrameScaleReadout" Grid.Column="1" Text="100%"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                               Foreground="{DynamicResource TextMuted}" />
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                    <TextBlock Text="Rotación" Foreground="{DynamicResource Text}" FontSize="13" />
                                    <TextBlock x:Name="FrameRotationReadout" Grid.Column="1" Text="0°"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                               Foreground="{DynamicResource TextMuted}" />
                                </Grid>

                                <TextBlock Text="Animación" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,14,0,0" />
                                <TextBlock Text="Pon un punto, mueve el cabezal y cambia el encuadre: entre dos puntos, el zoom o la posición van solos."
                                           FontSize="11" TextWrapping="Wrap" LineHeight="16"
                                           Foreground="{DynamicResource TextFaint}" />

                                <TextBlock Text="Zoom" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,0" />
                                <ctl:KeyframeStrip x:Name="FrameScaleKeys" />
                                <TextBlock Text="Posición" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0" />
                                <ctl:KeyframeStrip x:Name="FramePositionKeys" />
                                <TextBlock Text="Rotación" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0" />
                                <ctl:KeyframeStrip x:Name="FrameRotationKeys" />

                                <Button x:Name="FrameResetButton" Content="Restablecer" Classes="quiet"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Margin="0,14,0,0" />
                                <TextBlock Text="Girar sin haber acercado lo suficiente deja ver las esquinas del fotograma en negro; acerca más para taparlas."
                                           FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextFaint}" />
                            </StackPanel>

                            <StackPanel x:Name="TransitionControls" Spacing="6" IsVisible="False">
                                <TextBlock Text="Tipo" Foreground="{DynamicResource Text}" FontSize="13" />
                                <ComboBox x:Name="TransitionKindCombo" HorizontalAlignment="Stretch" />

                                <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                                    <TextBlock Text="Duración" Foreground="{DynamicResource Text}" FontSize="13"
                                               ToolTip.Tip="Cuánto se solapan el clip anterior y este mientras se funden" />
                                    <TextBlock x:Name="TransitionDurationReadout" Grid.Column="1" Text="0.5 s"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                               Foreground="{DynamicResource TextMuted}" />
                                </Grid>
                                <Slider x:Name="TransitionDurationSlider" Minimum="0.1" Maximum="3" Value="0.5"
                                        TickFrequency="0.1" IsSnapToTickEnabled="True" />

                                <Button x:Name="TransitionRemoveButton" Content="Quitar transición" Classes="quiet"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Margin="0,14,0,0" />
                                <TextBlock Text="Solapa el final de este clip con el principio del que sigue. Se acota al clip más corto de los dos."
                                           FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextFaint}" />
                            </StackPanel>

                            <StackPanel x:Name="SpeedControls" Spacing="6" IsVisible="False">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Velocidad" Foreground="{DynamicResource Text}" FontSize="13" />
                                    <TextBlock x:Name="SpeedReadout" Grid.Column="1" Text="1,0×"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                               Foreground="{DynamicResource TextMuted}" />
                                </Grid>
                                <Slider x:Name="SpeedSlider" Minimum="-3.321928" Maximum="4" Value="0" />

                                <WrapPanel Margin="0,4,0,0">
                                    <Button x:Name="Speed025Button" Content="0,25×" Classes="quiet" FontSize="11" Padding="10,5" Margin="0,4,4,0" />
                                    <Button x:Name="Speed05Button" Content="0,5×" Classes="quiet" FontSize="11" Padding="10,5" Margin="0,4,4,0" />
                                    <Button x:Name="Speed1Button" Content="1×" Classes="quiet" FontSize="11" Padding="10,5" Margin="0,4,4,0" />
                                    <Button x:Name="Speed2Button" Content="2×" Classes="quiet" FontSize="11" Padding="10,5" Margin="0,4,4,0" />
                                    <Button x:Name="Speed4Button" Content="4×" Classes="quiet" FontSize="11" Padding="10,5" Margin="0,4,4,0" />
                                </WrapPanel>

                                <TextBlock x:Name="SpeedDurationReadout" Text="Dura 0:00" FontSize="12" Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextMuted}" />

                                <Button x:Name="SpeedResetButton" Content="Restablecer" Classes="quiet"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Margin="0,10,0,0" />
                                <TextBlock Text="Más rápido acorta el clip en la timeline; más lento lo alarga. El audio se ajusta con el mismo cambio de velocidad, sin que suene raro de tono."
                                           FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextFaint}" />
                            </StackPanel>

                            <StackPanel x:Name="FiltersControls" Spacing="6" IsVisible="False">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox x:Name="FilterSearchBox" Watermark="Buscar filtros" />
                                </Grid>
                                <ScrollViewer MaxHeight="360" Margin="0,8,0,0">
                                    <WrapPanel x:Name="FilterGallery" />
                                </ScrollViewer>

                                <Border Margin="0,14,0,0" Padding="0,12,0,0"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Fundido" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Fundido de entrada" Foreground="{DynamicResource Text}" FontSize="13"
                                                       ToolTip.Tip="Empieza en negro y en silencio, y se abre hasta lo normal" />
                                            <TextBlock x:Name="ClipFadeInReadout" Grid.Column="1" Text="0 s"
                                                       FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </Grid>
                                        <Slider x:Name="ClipFadeInSlider" Minimum="0" Maximum="5" Value="0"
                                                TickFrequency="0.1" IsSnapToTickEnabled="True" />

                                        <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                            <TextBlock Text="Fundido de salida" Foreground="{DynamicResource Text}" FontSize="13"
                                                       ToolTip.Tip="Termina cerrando a negro y en silencio" />
                                            <TextBlock x:Name="ClipFadeOutReadout" Grid.Column="1" Text="0 s"
                                                       FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </Grid>
                                        <Slider x:Name="ClipFadeOutSlider" Minimum="0" Maximum="5" Value="0"
                                                TickFrequency="0.1" IsSnapToTickEnabled="True" />

                                        <Button x:Name="FadeResetButton" Content="Restablecer" Classes="quiet"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Margin="0,10,0,0" />
                                        <TextBlock Text="El fundido afecta a la imagen y también al propio audio del clip."
                                                   FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextFaint}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="EffectsControls" Spacing="6" IsVisible="False">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox x:Name="EffectSearchBox" Watermark="Buscar efectos" />
                                </Grid>
                                <ScrollViewer MaxHeight="360" Margin="0,8,0,0">
                                    <WrapPanel x:Name="EffectGallery" />
                                </ScrollViewer>
                                <TextBlock Text="Otros como zoom, giro, flash o pantalla verde exigen que la imagen cambie con el tiempo o se combine con otra fuente, así que quedan fuera de este primer paquete."
                                           FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,10,0,0"
                                           Foreground="{DynamicResource TextFaint}" />
                            </StackPanel>

                            <StackPanel x:Name="AudioControls" Spacing="6" IsVisible="False">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Volumen" Foreground="{DynamicResource Text}" FontSize="13" />
                                    <TextBlock x:Name="GainReadout" Grid.Column="1" Text="0 dB"
                                               FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                               Foreground="{DynamicResource TextMuted}" />
                                </Grid>
                                <Slider x:Name="GainSlider" Minimum="-40" Maximum="12" Value="0"
                                        TickFrequency="1" IsSnapToTickEnabled="True" />
                                <Button x:Name="GainResetButton" Content="Restablecer" Classes="quiet"
                                        HorizontalAlignment="Left" Padding="12,5" FontSize="12" />

                                <StackPanel x:Name="VolumeAutomationControls" Spacing="4" Margin="0,10,0,0">
                                    <TextBlock Text="Automatizacion del volumen" Foreground="{DynamicResource Text}" FontSize="13" />
                                    <TextBlock Text="Pon un punto, mueve el cabezal y cambia el volumen: sirve para agachar la musica bajo una voz sin cortar el clip."
                                               FontSize="11" TextWrapping="Wrap" LineHeight="16"
                                               Foreground="{DynamicResource TextFaint}" />
                                    <ctl:KeyframeStrip x:Name="VolumeKeys" />
                                </StackPanel>

                                <StackPanel x:Name="PanControls" Spacing="6" Margin="0,10,0,0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Balance" Foreground="{DynamicResource Text}" FontSize="13"
                                                   ToolTip.Tip="Hacia dónde suena más: izquierda o derecha" />
                                        <TextBlock x:Name="PanReadout" Grid.Column="1" Text="Centro"
                                                   FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </Grid>
                                    <Slider x:Name="PanSlider" Minimum="-100" Maximum="100" Value="0"
                                            TickFrequency="1" IsSnapToTickEnabled="True" />
                                </StackPanel>

                                <CheckBox x:Name="MuteCheck" Content="Silenciar" Margin="0,10,0,0" />

                                <Button x:Name="DetachButton" Content="Separar audio del video" Classes="quiet"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Margin="0,10,0,0" />

                                <StackPanel x:Name="FadeControls" Spacing="6" Margin="0,14,0,0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Fundido de entrada" Foreground="{DynamicResource Text}" FontSize="13" />
                                        <TextBlock x:Name="FadeInReadout" Grid.Column="1" Text="0 s"
                                                   FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </Grid>
                                    <Slider x:Name="FadeInSlider" Minimum="0" Maximum="5" Value="0"
                                            TickFrequency="0.1" IsSnapToTickEnabled="True" />

                                    <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                        <TextBlock Text="Fundido de salida" Foreground="{DynamicResource Text}" FontSize="13" />
                                        <TextBlock x:Name="FadeOutReadout" Grid.Column="1" Text="0 s"
                                                   FontFamily="Consolas,Menlo,monospace" FontSize="12"
                                                   Foreground="{DynamicResource TextMuted}" />
                                    </Grid>
                                    <Slider x:Name="FadeOutSlider" Minimum="0" Maximum="5" Value="0"
                                            TickFrequency="0.1" IsSnapToTickEnabled="True" />
                                </StackPanel>

                                <Border x:Name="AudioEffectControls" Margin="0,14,0,0" Padding="0,12,0,0"
                                        BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Efecto de sonido" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text}" />
                                        <WrapPanel x:Name="AudioEffectGallery" />
                                        <TextBlock Text="Un ecualizador paramétrico o un mezclador con automatización por keyframes son un paso posterior; esto son tratamientos ya hechos, de un clic."
                                                   FontSize="11" TextWrapping="Wrap" LineHeight="16" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextFaint}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Columna de pestañas derecha -->
                <Border Grid.Column="4" Background="{DynamicResource Sidebar}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Padding="6,10">
                    <StackPanel Spacing="4">
                        <Button x:Name="RailLayer" Classes="rail" ToolTip.Tip="Texto o imagen seleccionado: contenido, posición y tiempo">
                            <StackPanel Spacing="5">
                                <Path Data="{StaticResource IconLayers}" Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="20" Height="20" />
                                <TextBlock Text="Capa" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RailAudio" Classes="rail" ToolTip.Tip="Volumen, silencio y fundidos del clip seleccionado">
                            <StackPanel Spacing="5">
                                <Path Data="{StaticResource IconAudio}" Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="20" Height="20" />
                                <TextBlock Text="Audio" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RailFilters" Classes="rail" ToolTip.Tip="Filtros: presets de color de un clic para el clip seleccionado">
                            <StackPanel Spacing="5">
                                <Path Data="{StaticResource IconFilters}" Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="20" Height="20" />
                                <TextBlock Text="Filtros" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RailEffects" Classes="rail" ToolTip.Tip="Efectos: fundido a negro y a silencio del clip seleccionado">
                            <StackPanel Spacing="5">
                                <Path Data="{StaticResource IconEffects}" Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="20" Height="20" />
                                <TextBlock Text="Efectos" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RailColor" Classes="rail" ToolTip.Tip="Color: exposición, contraste, saturación y temperatura del clip seleccionado">
                            <StackPanel Spacing="5">
                                <Path Data="{StaticResource IconColor}" Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="20" Height="20" />
                                <TextBlock Text="Color" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RailFrame" Classes="rail" ToolTip.Tip="Encuadre: zoom, posición y rotación del clip seleccionado">
                            <StackPanel Spacing="5">
                                <Path Data="{StaticResource IconFrame}" Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="20" Height="20" />
                                <TextBlock Text="Encuadre" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RailTransition" Classes="rail" ToolTip.Tip="Transición desde el clip anterior, para el clip seleccionado">
                            <StackPanel Spacing="5">
                                <Path Data="{StaticResource IconTransition}" Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="20" Height="20" />
                                <TextBlock Text="Transición" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RailSpeed" Classes="rail" ToolTip.Tip="Velocidad de reproducción del clip seleccionado">
                            <StackPanel Spacing="5">
                                <Path Data="{StaticResource IconSpeed}" Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="20" Height="20" />
                                <TextBlock Text="Velocidad" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Barra de estado -->
            <Border Grid.Row="2" Background="{DynamicResource Panel}" Padding="16,0"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="StatusLabel" Text="Iniciando…" FontSize="11.5"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" x:Name="TimelineStats" Text="0 clips · 00:00" Margin="16,0,0,0"
                               FontFamily="Consolas,Menlo,monospace" FontSize="10.5"
                               Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
