<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="EditFlow.App.MainWindow"
        Title="EditFlow"
        Width="1280" Height="720"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <!-- Andamiaje. La interfaz real (media pool, preview y timeline)
         llega en la Fase 1. -->
    <Border Padding="32">
        <StackPanel Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="EditFlow"
                       FontSize="34" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Editor de video nativo — andamiaje del proyecto"
                       Opacity="0.7" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>

</Window>
