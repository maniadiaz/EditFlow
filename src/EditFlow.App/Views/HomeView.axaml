<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
             x:Class="EditFlow.App.Views.HomeView">

    <Grid ColumnDefinitions="248,*" Background="{DynamicResource Bg}">

        <!-- Barra lateral -->
        <Border Grid.Column="0" Background="{DynamicResource Sidebar}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="8,8,8,28">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource HeroGradient}">
                        <Path Data="{StaticResource IconPlay}" Fill="White" Stretch="Uniform"
                              Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="EditFlow" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <Button x:Name="HomeNav" Classes="nav selected">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Data="{StaticResource IconHome}" Fill="{Binding $parent[Button].Foreground}"
                                  Stretch="Uniform" Width="18" Height="18" />
                            <TextBlock Text="Inicio" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TemplatesNav" Classes="nav">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Data="{StaticResource IconTemplates}" Fill="{Binding $parent[Button].Foreground}"
                                  Stretch="Uniform" Width="18" Height="18" />
                            <TextBlock Text="Plantillas" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Contenido -->
        <Grid Grid.Column="1">

            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="44,36,44,44" MaxWidth="1240" HorizontalAlignment="Left">

                    <TextBlock Text="Bienvenido a EditFlow" FontSize="28" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" />

                    <!-- Crear un proyecto nuevo -->
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,26,0,0">
                        <Button x:Name="NewProjectButton" Classes="hero" Width="400" Height="84"
                                ToolTip.Tip="Empezar un proyecto vacío  (Ctrl + N)">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="Crear un nuevo proyecto" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Empieza a editar desde cero" FontSize="12" Opacity="0.85" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="38" Height="38" CornerRadius="19"
                                        Background="#33FFFFFF" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconPlus}" Fill="White" Stretch="Uniform"
                                          Width="18" Height="18" />
                                </Border>
                            </Grid>
                        </Button>

                        <Button x:Name="OpenProjectButton" Classes="card" Width="300" Height="84"
                                ToolTip.Tip="Abrir un archivo .editflow  (Ctrl + O)">
                            <Grid ColumnDefinitions="Auto,*" Margin="20,0">
                                <Path Data="{StaticResource IconFolder}" Fill="{DynamicResource TextMuted}"
                                      Stretch="Uniform" Width="24" Height="24" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="Abrir un proyecto" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text}" />
                                    <TextBlock Text="Desde un archivo .editflow" FontSize="12"
                                               Foreground="{DynamicResource TextMuted}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Proyectos guardados -->
                    <TextBlock Text="Tus proyectos" FontSize="19" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" Margin="0,44,0,16" />

                    <WrapPanel x:Name="ProjectsPanel" />

                    <Border x:Name="EmptyState" Padding="0,56" CornerRadius="12"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            IsVisible="False">
                        <StackPanel HorizontalAlignment="Center" Spacing="10">
                            <Path Data="{StaticResource IconFilm}" Fill="{DynamicResource TextFaint}"
                                  Stretch="Uniform" Width="44" Height="44" HorizontalAlignment="Center" />
                            <TextBlock Text="Empieza con un Nuevo Proyecto" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" HorizontalAlignment="Center" />
                            <TextBlock Text="Los proyectos que guardes aparecerán aquí."
                                       FontSize="12" Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="TemplatesPage" IsVisible="False">
                <StackPanel Margin="44,36,44,44" HorizontalAlignment="Left">
                    <TextBlock Text="Plantillas" FontSize="28" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text}" />
                    <Border Margin="0,26,0,0" Padding="0,56" CornerRadius="12" Width="640"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" Spacing="10">
                            <Path Data="{StaticResource IconTemplates}" Fill="{DynamicResource TextFaint}"
                                  Stretch="Uniform" Width="44" Height="44" HorizontalAlignment="Center" />
                            <TextBlock Text="Las plantillas llegarán pronto" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}" HorizontalAlignment="Center" />
                            <TextBlock Text="Por ahora, crea un proyecto desde cero en Inicio."
                                       FontSize="12" Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Avisos: proyecto que no se pudo abrir, etc. -->
            <Border x:Name="MessageBar" IsVisible="False" VerticalAlignment="Bottom"
                    HorizontalAlignment="Center" Margin="24" Padding="18,12" CornerRadius="8"
                    Background="#3a1f22" BorderBrush="{DynamicResource Danger}" BorderThickness="1"
                    MaxWidth="720">
                <TextBlock x:Name="MessageText" Foreground="{DynamicResource Text}" FontSize="13"
                           TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
