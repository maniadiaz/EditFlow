<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EditFlow.App.App"
             RequestedThemeVariant="Dark">

    <!--
        Paleta de EditFlow. Las superficies suben de claridad con la jerarquía (fondo, panel,
        tarjeta) y el único color vivo es el acento, reservado a lo que el usuario debe ver
        primero: crear, exportar, lo seleccionado.
    -->
    <Application.Resources>
        <Color x:Key="AccentColor">#2F8CFF</Color>
        <Color x:Key="AccentHoverColor">#5AA5FF</Color>

        <SolidColorBrush x:Key="Bg">#141416</SolidColorBrush>
        <SolidColorBrush x:Key="Sidebar">#18181b</SolidColorBrush>
        <SolidColorBrush x:Key="Panel">#1c1c20</SolidColorBrush>
        <SolidColorBrush x:Key="Card">#222228</SolidColorBrush>
        <SolidColorBrush x:Key="CardHover">#2a2a32</SolidColorBrush>
        <SolidColorBrush x:Key="Line">#2a2a30</SolidColorBrush>
        <SolidColorBrush x:Key="Text">#e8e8ea</SolidColorBrush>
        <SolidColorBrush x:Key="TextMuted">#9a9aa2</SolidColorBrush>
        <SolidColorBrush x:Key="TextFaint">#6a6a72</SolidColorBrush>
        <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
        <SolidColorBrush x:Key="Danger">#e5484d</SolidColorBrush>

        <LinearGradientBrush x:Key="HeroGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#2F6BFF" Offset="0" />
            <GradientStop Color="#1FB8D9" Offset="1" />
        </LinearGradientBrush>

        <!-- Iconos propios, en una cuadrícula de 24 × 24. -->
        <StreamGeometry x:Key="IconHome">M12,3 L3,11 H6 V20 H10.5 V14 H13.5 V20 H18 V11 H21 Z</StreamGeometry>
        <StreamGeometry x:Key="IconTemplates">M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z</StreamGeometry>
        <StreamGeometry x:Key="IconPlus">M11,5 H13 V11 H19 V13 H13 V19 H11 V13 H5 V11 H11 Z</StreamGeometry>
        <StreamGeometry x:Key="IconFolder">M3,6 H10 L12,8 H21 V19 H3 Z</StreamGeometry>
        <StreamGeometry x:Key="IconPlay">M8,5 L19,12 L8,19 Z</StreamGeometry>
        <StreamGeometry x:Key="IconFilm">M4,5 H20 V19 H4 Z M6,7 V9 H8 V7 Z M6,11 V13 H8 V11 Z M6,15 V17 H8 V15 Z M16,7 V9 H18 V7 Z M16,11 V13 H18 V11 Z M16,15 V17 H18 V15 Z</StreamGeometry>
        <StreamGeometry x:Key="IconText">M5,5 H19 V8 H13.5 V19 H10.5 V8 H5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconTransition">M3,6 H14 V17 H3 Z M10,9 H21 V20 H10 Z</StreamGeometry>
        <StreamGeometry x:Key="IconAudio">M4,9 H8 L13,5 V19 L8,15 H4 Z M15.5,8.5 Q18.5,12 15.5,15.5 L17,17 Q21.5,12 17,7 Z</StreamGeometry>
        <StreamGeometry x:Key="IconFilters">F0 M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 Z M12,7 A5,5 0 1 1 12,17 A5,5 0 1 1 12,7 Z</StreamGeometry>
        <StreamGeometry x:Key="IconEffects">M12,3 L14,10 L21,12 L14,14 L12,21 L10,14 L3,12 L10,10 Z</StreamGeometry>
        <StreamGeometry x:Key="IconColor">M12,3 A9,9 0 0 0 12,21 Z</StreamGeometry>
        <StreamGeometry x:Key="IconSpeed">M4,6 L12,12 L4,18 Z M12,6 L20,12 L12,18 Z</StreamGeometry>
        <StreamGeometry x:Key="IconUndo">M9,6 L3,12 L9,18 V14 Q17,13.5 20,20 Q19.5,9.5 9,10 Z</StreamGeometry>
        <StreamGeometry x:Key="IconScissors">M9,9 L20,20 M9,15 L20,4 M9,7 A3,3 0 1 1 3,7 A3,3 0 1 1 9,7 Z M9,17 A3,3 0 1 1 3,17 A3,3 0 1 1 9,17 Z</StreamGeometry>
        <StreamGeometry x:Key="IconTrash">M6,7 H18 V8.5 H6 Z M8,9.5 H16 V20 H8 Z M10,4 H14 V6 H10 Z</StreamGeometry>
        <StreamGeometry x:Key="IconPause">M7,5 H11 V19 H7 Z M13,5 H17 V19 H13 Z</StreamGeometry>
        <StreamGeometry x:Key="IconSkipStart">M6,5 H8 V19 H6 Z M20,5 V19 L9,12 Z</StreamGeometry>
        <StreamGeometry x:Key="IconMinus">M5,11 H19 V13 H5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconFit">M4,5 H6 V19 H4 Z M18,5 H20 V19 H18 Z M8,11 H16 V13 H8 Z</StreamGeometry>
        <StreamGeometry x:Key="IconLayers">M12,4 L20,9 L12,14 L4,9 Z M4,13 L12,18 L20,13 L20,15 L12,20 L4,15 Z</StreamGeometry>
        <StreamGeometry x:Key="IconImport">M11,4 H13 V12 L16,9 L17.5,10.5 L12,16 L6.5,10.5 L8,9 L11,12 Z M5,18 H19 V20 H5 Z</StreamGeometry>
        <StreamGeometry x:Key="IconMusic">M9,5 L19,3 V16 A3,3 0 1 1 17,13.2 V7 L11,8.2 V17 A3,3 0 1 1 9,14.2 Z</StreamGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- El acento de los controles estándar (deslizadores, casillas) es el de EditFlow. -->
                <ColorPaletteResources x:Key="Dark" Accent="#2F8CFF" />
            </FluentTheme.Palettes>
        </FluentTheme>

        <!-- Acción principal: rellena, con el acento. -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHover}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Elemento de la barra lateral. -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>
        <Style Selector="Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>

        <!-- Tarjeta pulsable: proyectos y accesos grandes. -->
        <Style Selector="Button.card">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>

        <!-- Acceso destacado de la pantalla de inicio. -->
        <Style Selector="Button.hero">
            <Setter Property="Background" Value="{DynamicResource HeroGradient}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.hero:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HeroGradient}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Opacity" Value="0.92" />
        </Style>
        <!-- Botón de icono de las barras de herramientas. -->
        <Style Selector="Button.tool">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>
        <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- Botón de texto discreto de la barra superior y de las tarjetas. -->
        <Style Selector="Button.quiet">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="14,7" />
        </Style>
        <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHover}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>

        <!-- Pestaña de las columnas de iconos: icono arriba, nombre pequeño debajo. -->
        <Style Selector="Button.rail">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Width" Value="64" />
            <Setter Property="Padding" Value="0,9" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style Selector="Button.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>
        <Style Selector="Button.rail.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Button.rail.soon">
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <!-- Botón redondo de reproducir. -->
        <Style Selector="Button.play">
            <Setter Property="Background" Value="{DynamicResource Text}" />
            <Setter Property="Foreground" Value="#141416" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="21" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#141416" />
        </Style>

        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        </Style>
    </Application.Styles>
</Application>
