# ============================================================================
#  EditFlow — .gitattributes
#
#  Sin este archivo, los editores de Windows introducen CRLF y los diffs se
#  llenan de ruido que oculta los cambios reales.
# ============================================================================

# Normalización por defecto: LF en el repositorio.
* text=auto eol=lf

# ----------------------------------------------------------------------------
#  Archivos que Windows EXIGE con CRLF para funcionar
# ----------------------------------------------------------------------------
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.sln   text eol=crlf

# ----------------------------------------------------------------------------
#  Hooks de git: deben ser LF SIEMPRE, incluso en Windows.
#  Con CRLF, sh falla con "bad interpreter: No such file or directory".
# ----------------------------------------------------------------------------
.githooks/*  text eol=lf

# ----------------------------------------------------------------------------
#  Código y configuración
# ----------------------------------------------------------------------------
*.cs      text diff=csharp
*.csproj  text
*.props   text
*.targets text
*.axaml   text
*.xaml    text
*.json    text
*.yml     text
*.yaml    text
*.md      text
*.sh      text eol=lf

# ----------------------------------------------------------------------------
#  Binarios: nunca normalizar
# ----------------------------------------------------------------------------
*.exe  binary
*.dll  binary
*.so   binary
*.dylib binary
*.pdb  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.icns binary
*.zip  binary
*.7z   binary
*.gz   binary
*.ttf  binary
*.otf  binary
*.cube binary
