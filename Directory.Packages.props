<Project>

  <!--
    Gestión centralizada de versiones de paquetes.
    Los .csproj declaran <PackageReference Include="X" /> sin Version.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    ⚠️  Avalonia está FIJADO a 11.3.x de forma exacta.

    LibVLCSharp.Avalonia 3.10.1 declara `Avalonia >= 11.3.13` y no soporta la
    rama 12.x. Subir Avalonia a 12 rompe el reproductor de preview.

    El reproductor está aislado tras IPreviewPlayer: cuando LibVLCSharp
    soporte la rama 12 —o cuando se sustituya por un renderer propio—
    basta con cambiar estas líneas.
  -->
  <ItemGroup Label="Avalonia (pinned &lt; 12.0)">
    <PackageVersion Include="Avalonia" Version="[11.3.22]" />
    <PackageVersion Include="Avalonia.Desktop" Version="[11.3.22]" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="[11.3.22]" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="[11.3.22]" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="[11.3.22]" />
  </ItemGroup>

  <ItemGroup Label="Preview (LibVLC)">
    <PackageVersion Include="LibVLCSharp" Version="3.10.1" />
    <PackageVersion Include="LibVLCSharp.Avalonia" Version="3.10.1" />
    <PackageVersion Include="VideoLAN.LibVLC.Windows" Version="3.0.23" />
  </ItemGroup>

  <ItemGroup Label="MVVM">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

</Project>
