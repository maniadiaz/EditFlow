#!/bin/sh
#
# EditFlow — commit-msg hook
# Enforces Conventional Commits 1.0.0.
#
# Enable with:  git config core.hooksPath .githooks
#
# Format:  <type>(<scope>)<!>: <description>
#   - description in English, imperative mood, <= 72 chars, no trailing period
#   - `!` before the colon marks a breaking change
#
set -u

msg_file="$1"

# First non-comment, non-empty line is the subject.
subject=$(grep -v '^#' "$msg_file" | grep -v '^[[:space:]]*$' | head -n 1)

# Merge and revert commits generated by git itself are exempt.
case "$subject" in
    "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
pattern="^($types)(\([a-z0-9._-]+\))?!?: .{1,72}$"

if printf '%s' "$subject" | grep -Eq "$pattern"; then
    # Reject a trailing period on the subject line.
    case "$subject" in
        *.)
            echo "✗ Commit rejected: the subject line must not end with a period."
            echo "  Subject: $subject"
            exit 1
            ;;
    esac
    exit 0
fi

cat >&2 <<'EOF'
✗ Commit rejected: the message does not follow Conventional Commits 1.0.0.

  Format:  <type>(<scope>): <description>

  Types:   feat  fix   docs  style refactor
           perf  test  build ci    chore  revert

  Scopes:  core  engine app   timeline
           export preview ffmpeg deps

  Rules:   description in English, imperative mood,
           1-72 characters, no trailing period.

  Examples:
    feat(timeline): split clip at playhead with S key
    fix(export): force -b:v 0 in NVENC CQ mode
    test(engine): cover filter graph for clip without audio
    chore(deps): pin Avalonia to [11.3.13,12.0.0)

  Breaking change:
    feat(core)!: change project file schema

EOF

echo "  Your subject was:" >&2
echo "    $subject" >&2
exit 1
